# Postgres
POSTGRES_USER=cv_screener
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=cv_screener
POSTGRES_PORT=5432

# Service ports
FRONTEND_PORT=3000
CV_SERVICE_PORT=4002
CV_INGESTION_SERVICE_PORT=4003
CV_GENERATOR_PORT=4001

# Database connection
DATABASE_URL=postgres://cv_screener:change_me_postgres@localhost:5432/cv_screener

# RAG configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_SOURCES=3

# Gemini retry configuration
GEMINI_RETRY_MAX=3
GEMINI_RETRY_BASE_DELAY_MS=250
GEMINI_RETRY_MAX_DELAY_MS=8000

# Minimum delay between Gemini CV generation calls to avoid rate limiting (429)
CV_GENERATION_DELAY_MS=60000

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Storage
PDF_STORAGE_PATH=/data/cvs
DATA_VOLUME_PATH=/data/cvs

# Frontend
NEXT_PUBLIC_CV_SERVICE_URL=http://localhost:4002
